{
    "name": "softspring/cms-module-collection",
    "description": "A module collection for softspring/cms-bundle",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "softspring/cms-bundle": "^6.0@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "symfony/form": "^6.4|^7.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsModuleCollection\\Test\\Modules\\": "tests/modules"
        }
    }
}
