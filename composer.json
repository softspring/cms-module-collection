{
    "name": "softspring/cms-module-collection",
    "description": "A module collection for softspring/cms-bundle",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "softspring/cms-bundle": "^5.2@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.54",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^1.0",
        "symfony/form": "^6.4|^7.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsModuleCollection\\Test\\Modules\\": "tests/modules"
        }
    }
}
