{% import '@SfsCms/macros/modules_render.html.twig' as module %}

{% set versionSplit = media.version|split('#') %}
{% set versionType = versionSplit[0]|default('image') %}
{% set versionKey = versionSplit[1]|default('_original') %}

<div {{ module.class(aligment_media, 'd-flex') }}>
    {% if versionType == 'image' %}
        {{ media.media|sfs_media_render_image(versionKey, {'class':'img-fluid'}) }}
    {% elseif versionType == 'video' %}
        {{ media.media|sfs_media_render_video(versionKey, {'class':'img-fluid'}) }}
    {% elseif versionType == 'picture' %}
        {{ media.media|sfs_media_render_picture(versionKey, {'class':'img-fluid'}) }}
    {% endif %}
</div>
